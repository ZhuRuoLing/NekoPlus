{
	"format_version": "1.8.0",
	"animations": {
		"nekoplus:animation.tardis.default": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.0833
		},
		"nekoplus:animation.tardis.door_half_open": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.0833,
			"bones": {
				"door_right": {
					"rotation": [0, 30, 0]
				}
			}
		},
		"nekoplus:animation.tardis.rotating": {
			"loop": true,
			"bones": {
				"bone": {
					"rotation": [0, "-math.mod(q.anim_time * 360 * tardis.rotating_speed, 360)", 0]
				},
				"door": {
					"rotation": [0, 0, 0]
				}
			}
		},
		"nekoplus:animation.tardis.rotating1": {
			"loop": true,
			"bones": {
				"bone": {
					"rotation": [0, "-math.mod(q.anim_time * 360 * 2, 360)", 0.01]
				},
				"door": {
					"rotation": [0, 0, 0]
				}
			}
		},
		"nekoplus:animation.tardis.floating": {
			"loop": true,
			"bones": {
				"door": {
					"rotation": [0, 0, 0]
				},
				"bone2": {
					"position": [
						0,
						"math.sin(q.anim_time * 360 * tardis.floating.speed) * tardis.floating.delta_height + tardis.floating.delta_height + tardis.floating.min_height",
						0
					]
				}
			}
		},
		"nekoplus:animation.tardis.door_open": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.0833,
			"bones": {
				"door_right": {
					"rotation": [0, 80, 0]
				}
			}
		},
		"nekoplus:animation.tardis.door_double_open": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.0417,
			"bones": {
				"door_left": {
					"rotation": [0, -80, 0]
				},
				"door_right": {
					"rotation": [0, 80, 0]
				}
			}
		},
		"nekoplus:animation.tardis.waving": {
			"loop": true,
			"bones": {
				"bone2": {
					"rotation": [
						"-math.sin((q.anim_time + 0.25) * 360 * tardis.waving.speed) * tardis.waving.delta_deg",
						0,
						"math.sin(q.anim_time * 360 * tardis.waving.speed) * tardis.waving.delta_deg"
					]
				}
			}
		},
		"nekoplus:animation.tardis.flashing": {
			"loop": true,
			"bones": {
				"light": {
					"relative_to": "geckolib_not_used",
					"rotation": [-30, "-math.mod(q.anim_time * 360, 360)", 45],
					"scale": "math.sin(q.anim_time * 180 * tardis.flashing.speed) * tardis.flashing.size + tardis.flashing.size"
				}
			}
		}
	}
}